# --- Production (Turso / libSQL) ---
# Create a database at https://turso.tech then:
#   turso db show <name> --url        -> TURSO_DATABASE_URL (libsql://…)
#   turso db tokens create <name>     -> TURSO_AUTH_TOKEN
# Set both in your hosting provider's environment variables (e.g. Vercel).
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# --- Local development (SQLite file) ---
# Used by the Prisma CLI (migrations / db push). The app falls back to this same
# file automatically when TURSO_DATABASE_URL is not set.
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
